@model DepatmentDetailsDto

<div class="container py-3">
@if(Model is null)
{

    <section id="team" class="team section">
        <div class="alert alert-danger text-center fw-bold">
            <p>This Department Was not Found</p>
            <a class="btn btn-secondary" asp-action="Index">Back To List</a>
        </div>
    </section>
}
else
{
    

<!-- Team Section -->
<section id="team" class="team section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>@Model.Name</h2>
        <p>@Model.Description</p>
        <p><small class="text-muted">@Model.CreatedBy    @Model.CreatedAt</small></p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">
            @foreach (var doctor in Model.Doctors)
            {


                        <div class="col-lg-6 shadow " data-aos="fade-up" data-aos-delay="100">
                            <div class="team-member d-flex align-items-start">
                                <div class="pic">
                                    <img src="~/Uploads/Doctors/@doctor.Image" class="img-fluid " alt="@doctor.FullName">
                                </div>
                                <div class="member-info p-4">
                                    <h4>@doctor.FullName</h4>
                                    <span>@doctor.UserName</span>
                                    <span>@doctor.Email</span>
                                    <p>@doctor.Spisalization</p>
                                    <span>@doctor.Phonenumber</span>
                                    <span>@doctor.DepartmentName</span>
                                    <span>@doctor.Gender</span>

                                    <div class="social">
                                        <a href=""><i class="bi bi-twitter-x"></i></a>
                                        <a href=""><i class="bi bi-facebook"></i></a>
                                        <a href=""><i class="bi bi-instagram"></i></a>
                                        <a href=""> <i class="bi bi-linkedin"></i> </a>
                                    </div>
                                </div>
                            </div>
                        </div>
            }
            
        </div>

    </div>

</section><!-- /Team Section -->
}
</div>